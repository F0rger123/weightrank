{
  "expo": {
    "name": "WeightRank",
    "slug": "weightrank",
    "scheme": "weightrank",
    "version": "0.5.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0B0D10",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "app.weightrank"
    },
    "android": {
      "package": "app.weightrank",
      "versionCode": 5,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.REQUEST_INSTALL_PACKAGES"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#0B0D10",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "output": "single"
    },
    "updates": {
      "enabled": false
    },
    "plugins": [
      "expo-router",
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 26
          }
        }
      ],
      "./plugins/withShortNativeBuildPath",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#07080A",
          "image": "./assets/splash-icon.png",
          "imageWidth": 150,
          "dark": {
            "backgroundColor": "#07080A",
            "image": "./assets/splash-icon.png"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false,
      "baseUrl": "/weightrank"
    },
    "extra": {
      "updateFeedUrl": "https://github.com/F0rger123/weightrank/releases/latest/download/latest.json",
      "webUrl": "https://f0rger123.github.io/weightrank",
      "firebase": {
        "apiKey": "AIzaSyCKHKAnG5rP8DgieIsarVsCdyUIBixnjMI",
        "authDomain": "weightrank-f0rger.firebaseapp.com",
        "projectId": "weightrank-f0rger",
        "appId": "1:49801699144:web:71074d8d1156a4438f1d7d",
        "databaseURL": "https://weightrank-f0rger-default-rtdb.firebaseio.com"
      }
    }
  }
}
